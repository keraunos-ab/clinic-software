    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="SettingsTitle">الإعدادات</sys:String>
    <sys:String x:Key="SettingsHeader">الإعدادات</sys:String>
    <sys:String x:Key="SettingsSubtitle">تحديث بياناتك</sys:String>
    
    <sys:String x:Key="SettingsSectionTitle">بيانات المستخدم</sys:String>
    
    <sys:String x:Key="LabelFirstName">الاسم الأول</sys:String>
    <sys:String x:Key="LabelLastName">اسم العائلة</sys:String>
    <sys:String x:Key="LabelPhone">رقم الهاتف</sys:String>
    <sys:String x:Key="LabelEmail">البريد الإلكتروني</sys:String>
    <sys:String x:Key="LabelOrdre">رقم الترتيب</sys:String>
    <sys:String x:Key="LabelSpecialty">تخصص الطبيب</sys:String>
    <sys:String x:Key="LabelClinicName">اسم العيادة</sys:String>
