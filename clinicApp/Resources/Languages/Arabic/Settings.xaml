    <sys:String x:Key="SettingsFooter">التغييرات هنا تحل محل المعلومات المقدمة أثناء التقديم.</sys:String>

    <!-- Password Protection Section -->
    <sys:String x:Key="PasswordSectionTitle">حماية كلمة المرور</sys:String>
    <sys:String x:Key="LabelEnablePassword">تفعيل حماية كلمة المرور</sys:String>
    <sys:String x:Key="LabelCurrentPassword">كلمة المرور الحالية</sys:String>
    <sys:String x:Key="LabelNewPassword">كلمة المرور الجديدة</sys:String>
