    <sys:String x:Key="BtnSetPassword">تعيين كلمة المرور</sys:String>
    <sys:String x:Key="BtnChangePassword">تغيير كلمة المرور</sys:String>
    <sys:String x:Key="BtnRemovePassword">إزالة كلمة المرور</sys:String>
    <sys:String x:Key="PasswordSetSuccess">تم تعيين كلمة المرور بنجاح.</sys:String>
    <sys:String x:Key="PasswordChangedSuccess">تم تغيير كلمة المرور بنجاح.</sys:String>
    <sys:String x:Key="PasswordRemovedSuccess">تمت إزالة حماية كلمة المرور.</sys:String>
    <sys:String x:Key="PasswordMismatch">كلمات المرور غير متطابقة.</sys:String>
    <sys:String x:Key="PasswordRequired">الرجاء إدخال كلمة المرور.</sys:String>
