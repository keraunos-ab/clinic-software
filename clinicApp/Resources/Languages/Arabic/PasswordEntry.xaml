<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="PasswordEntryTitle">إدخال كلمة المرور</sys:String>
    <sys:String x:Key="PasswordEntryHeader">تم تعيين كلمة المرور</sys:String>
    <sys:String x:Key="PasswordEntrySubtitle">الرجاء إدخال كلمة المرور للوصول إلى التطبيق</sys:String>
    <sys:String x:Key="PasswordEntryLabel">كلمة المرور</sys:String>
    <sys:String x:Key="PasswordEntryPlaceholder">أدخل كلمة المرور...</sys:String>
    <sys:String x:Key="BtnUnlock">فتح</sys:String>
    <sys:String x:Key="PasswordIncorrect">كلمة المرور غير صحيحة. حاول مرة أخرى.</sys:String>
    
    <!-- Settings page password section -->
    <sys:String x:Key="PasswordSectionTitle">إعدادات كلمة المرور</sys:String>
    <sys:String x:Key="LabelEnablePassword">تفعيل كلمة المرور</sys:String>
    <sys:String x:Key="LabelCurrentPassword">كلمة المرور الحالية</sys:String>
    <sys:String x:Key="LabelNewPassword">كلمة المرور الجديدة</sys:String>
    <sys:String x:Key="LabelConfirmPassword">تأكيد كلمة المرور الجديدة</sys:String>
    <sys:String x:Key="BtnSetPassword">تعيين كلمة المرور</sys:String>
    <sys:String x:Key="BtnChangePassword">تغيير كلمة المرور</sys:String>
    <sys:String x:Key="BtnRemovePassword">إزالة كلمة المرور</sys:String>
    <sys:String x:Key="PasswordSetSuccess">تم تعيين كلمة المرور بنجاح.</sys:String>
    <sys:String x:Key="PasswordChangedSuccess">تم تغيير كلمة المرور بنجاح.</sys:String>
    <sys:String x:Key="PasswordRemovedSuccess">تمت إزالة كلمة المرور بنجاح.</sys:String>
    <sys:String x:Key="PasswordMismatch">كلمات المرور غير متطابقة.</sys:String>
    <sys:String x:Key="PasswordRequired">يرجى إدخال كلمة المرور.</sys:String>
    <sys:String x:Key="CurrentPasswordIncorrect">كلمة المرور الحالية غير صحيحة.</sys:String>

</ResourceDictionary>
