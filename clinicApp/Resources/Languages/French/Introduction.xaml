    <sys:String x:Key="LabelPhone">Numéro de téléphone</sys:String>
    <sys:String x:Key="LabelEmail">Email (optionnel)</sys:String>
    <sys:String x:Key="LabelOrdre">N° ordre (optionnel)</sys:String>
