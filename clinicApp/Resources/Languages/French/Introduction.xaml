<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="IntroTitle">Introduction</sys:String>
    <sys:String x:Key="IntroWelcome">Bienvenue ! Veuillez vous présenter.</sys:String>
    <sys:String x:Key="IntroSubtitle">Les informations que vous entrez ci-dessous sont uniquement utilisées pour personnaliser votre logiciel de clinique.&#x0a;(vous pouvez les modifier plus tard)</sys:String>

    <sys:String x:Key="LabelFirstName">Prénom</sys:String>
