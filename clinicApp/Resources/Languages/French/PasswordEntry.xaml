<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="PasswordEntryTitle">Mot de passe requis</sys:String>
    <sys:String x:Key="PasswordEntryHeader">?? Entrer le mot de passe</sys:String>
    <sys:String x:Key="PasswordEntrySubtitle">Veuillez entrer votre mot de passe pour accéder à l'application</sys:String>
    <sys:String x:Key="PasswordEntryLabel">Mot de passe</sys:String>
    <sys:String x:Key="PasswordEntryPlaceholder">Entrez votre mot de passe...</sys:String>
    <sys:String x:Key="BtnUnlock">Déverrouiller</sys:String>
    <sys:String x:Key="PasswordIncorrect">Mot de passe incorrect. Veuillez réessayer.</sys:String>
    
    <!-- Settings page password section -->
    <sys:String x:Key="PasswordSectionTitle">Protection par mot de passe</sys:String>
    <sys:String x:Key="LabelEnablePassword">Activer la protection par mot de passe</sys:String>
    <sys:String x:Key="LabelCurrentPassword">Mot de passe actuel</sys:String>
    <sys:String x:Key="LabelNewPassword">Nouveau mot de passe</sys:String>
    <sys:String x:Key="LabelConfirmPassword">Confirmer le nouveau mot de passe</sys:String>
    <sys:String x:Key="BtnSetPassword">Définir le mot de passe</sys:String>
    <sys:String x:Key="BtnChangePassword">Changer le mot de passe</sys:String>
    <sys:String x:Key="BtnRemovePassword">Supprimer le mot de passe</sys:String>
    <sys:String x:Key="PasswordSetSuccess">Le mot de passe a été défini avec succès.</sys:String>
    <sys:String x:Key="PasswordChangedSuccess">Le mot de passe a été changé avec succès.</sys:String>
    <sys:String x:Key="PasswordRemovedSuccess">La protection par mot de passe a été supprimée.</sys:String>
    <sys:String x:Key="PasswordMismatch">Les mots de passe ne correspondent pas.</sys:String>
    <sys:String x:Key="PasswordRequired">Veuillez entrer un mot de passe.</sys:String>
    <sys:String x:Key="CurrentPasswordIncorrect">Le mot de passe actuel est incorrect.</sys:String>

</ResourceDictionary>
