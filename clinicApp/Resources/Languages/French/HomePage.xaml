<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="HomeTitle">Accueil</sys:String>
    
    <!-- Welcome message -->
    <sys:String x:Key="WelcomeBack">Bienvenue</sys:String>
    <sys:String x:Key="DrPrefix">Dr</sys:String>
    
    <!-- Counters - {0} is the count -->
    <sys:String x:Key="AppointmentCount">Vous avez {0} rendez-vous aujourd'hui.</sys:String>
    <sys:String x:Key="SessionCount">Vous avez effectu&#233; {0} s&#233;ance(s) aujourd&apos;hui.</sys:String>
    
    <!-- Date format for French culture -->
    <sys:String x:Key="DateTimeFormat">ddd d MMM &#8226; HH:mm:ss</sys:String>
    
</ResourceDictionary>