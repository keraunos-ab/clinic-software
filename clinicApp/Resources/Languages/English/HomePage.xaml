<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="HomeTitle">Home</sys:String>
    
    <!-- Welcome message - {0} is first name, {1} is last initial -->
    <sys:String x:Key="WelcomeBack">Welcome back</sys:String>
    <sys:String x:Key="DrPrefix">Dr.</sys:String>
    
    <!-- Counters - {0} is the count -->
    <sys:String x:Key="AppointmentCount">You have {0} appointment(s) today.</sys:String>
    <sys:String x:Key="SessionCount">You did {0} session(s) today.</sys:String>
    
    <!-- Date format for the culture -->
    <sys:String x:Key="DateTimeFormat">ddd, MMM d  &#x2022;  HH:mm:ss</sys:String>
    
</ResourceDictionary>