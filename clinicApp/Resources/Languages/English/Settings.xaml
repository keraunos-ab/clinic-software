<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="SettingsTitle">Settings</sys:String>
    <sys:String x:Key="SettingsHeader">Settings</sys:String>
    <sys:String x:Key="SettingsSubtitle">Update your credentials</sys:String>
    
    <sys:String x:Key="SettingsSectionTitle">User credentials</sys:String>
    
    <sys:String x:Key="LabelFirstName">First Name</sys:String>
    <sys:String x:Key="LabelLastName">Last Name</sys:String>
    <sys:String x:Key="LabelPhone">Phone Number</sys:String>
    <sys:String x:Key="LabelEmail">Email</sys:String>
    <sys:String x:Key="LabelOrdre">Order No.</sys:String>
    <sys:String x:Key="LabelSpecialty">Doctor Specialty</sys:String>
    <sys:String x:Key="LabelClinicName">Clinic Name</sys:String>
    <sys:String x:Key="LabelClinicAddress">Clinic Address</sys:String>
    <sys:String x:Key="LabelLogo">Clinic Logo (optional)</sys:String>
    
    <sys:String x:Key="BtnBrowseLogo">Browse...</sys:String>
    <sys:String x:Key="BtnSaveChanges">Save changes</sys:String>
    <sys:String x:Key="SettingsFooter">Changes here override the information provided during introduction.</sys:String>

    <!-- Password Protection Section -->
    <sys:String x:Key="PasswordSectionTitle">Password Protection</sys:String>
    <sys:String x:Key="LabelEnablePassword">Enable Password Protection</sys:String>
    <sys:String x:Key="LabelCurrentPassword">Current Password</sys:String>
    <sys:String x:Key="LabelNewPassword">New Password</sys:String>
    <sys:String x:Key="LabelConfirmPassword">Confirm New Password</sys:String>
    <sys:String x:Key="BtnSetPassword">Set Password</sys:String>
    <sys:String x:Key="BtnChangePassword">Change Password</sys:String>
    <sys:String x:Key="BtnRemovePassword">Remove Password</sys:String>
    <sys:String x:Key="PasswordSetSuccess">Password has been set successfully.</sys:String>
    <sys:String x:Key="PasswordChangedSuccess">Password has been changed successfully.</sys:String>
    <sys:String x:Key="PasswordRemovedSuccess">Password protection has been removed.</sys:String>
    <sys:String x:Key="PasswordMismatch">Passwords do not match.</sys:String>
    <sys:String x:Key="PasswordRequired">Please enter a password.</sys:String>
    <sys:String x:Key="CurrentPasswordIncorrect">Current password is incorrect.</sys:String>

</ResourceDictionary>