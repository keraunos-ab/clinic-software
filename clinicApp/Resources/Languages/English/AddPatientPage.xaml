<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="AddPatientTitle">Add New Patient</sys:String>

    <!-- Labels -->
    <sys:String x:Key="LabelFirstName">First Name</sys:String>
    <sys:String x:Key="LabelLastName">Last Name</sys:String>
    <sys:String x:Key="LabelDateOfBirth">Date of Birth</sys:String>
    <sys:String x:Key="LabelGender">Gender</sys:String>
    <sys:String x:Key="LabelWeight">Weight (kg)</sys:String>
    <sys:String x:Key="LabelBloodType">Blood Type</sys:String>
    <sys:String x:Key="LabelPhone">Phone</sys:String>
    <sys:String x:Key="LabelEmail">Email</sys:String>
    <sys:String x:Key="LabelNote">Note</sys:String>

    <!-- Gender options -->
    <sys:String x:Key="GenderMale">Male</sys:String>
    <sys:String x:Key="GenderFemale">Female</sys:String>

    <!-- Tooltips -->
    <sys:String x:Key="ToolTipFirstName">Enter patient's first name</sys:String>
    <sys:String x:Key="ToolTipLastName">Enter patient's last name</sys:String>
    <sys:String x:Key="ToolTipDateOfBirth">Select patient's date of birth</sys:String>
    <sys:String x:Key="ToolTipGender">Select patient's gender</sys:String>
    <sys:String x:Key="ToolTipWeight">Enter patient's weight in kg</sys:String>
    <sys:String x:Key="ToolTipBloodType">Select patient's blood type</sys:String>
    <sys:String x:Key="ToolTipPhone">Enter patient's phone number</sys:String>
    <sys:String x:Key="ToolTipEmail">Enter patient's email</sys:String>
    <sys:String x:Key="ToolTipNote">Optional notes about the patient</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="BtnSave">Save</sys:String>

</ResourceDictionary>