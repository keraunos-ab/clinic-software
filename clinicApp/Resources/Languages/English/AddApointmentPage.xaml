<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="AddAppointmentTitle">Add New Appointment</sys:String>
    
    <!-- Labels -->
    <sys:String x:Key="LabelSelectPatient">Select Patient</sys:String>
    <sys:String x:Key="LabelPatientLastName">Patient Last Name</sys:String>
    <sys:String x:Key="LabelDate">Date</sys:String>
    <sys:String x:Key="LabelTime">Time</sys:String>
    <sys:String x:Key="LabelNote">Note</sys:String>

    <!-- Tooltips -->
    <sys:String x:Key="ToolTipSearchPatient">Type to search patients</sys:String>
    <sys:String x:Key="ToolTipPatientLastName">Patient last name will auto-fill</sys:String>
    <sys:String x:Key="ToolTipTime">Enter time (e.g. 14:30)</sys:String>
    <sys:String x:Key="ToolTipNote">Optional note about the appointment</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="BtnSave">Save</sys:String>

</ResourceDictionary>