<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="IntroTitle">Introduction</sys:String>
    <sys:String x:Key="IntroWelcome">Welcome! Please introduce yourself.</sys:String>
    <sys:String x:Key="IntroSubtitle">The information you enter below is solely used to personalize your clinic software.(you can change it later)</sys:String>

    <sys:String x:Key="LabelFirstName">First Name</sys:String>
    <sys:String x:Key="LabelLastName">Last Name</sys:String>
    <sys:String x:Key="LabelPhone">Phone Number</sys:String>
    <sys:String x:Key="LabelEmail">Email (optional)</sys:String>
    <sys:String x:Key="LabelOrdre">N° ordre (optional)</sys:String>
    <sys:String x:Key="LabelSpecialty">Doctor Specialty</sys:String>
    <sys:String x:Key="LabelClinicName">Clinic Name</sys:String>
    <sys:String x:Key="LabelClinicAddress">Clinic Address</sys:String>
    <sys:String x:Key="LabelLogo">Logo / Image (optional)</sys:String>

    <sys:String x:Key="BtnBrowse">Browse...</sys:String>
    <sys:String x:Key="BtnContinue">Continue</sys:String>

    <sys:String x:Key="WinMin">—</sys:String>
    <sys:String x:Key="WinMax">□</sys:String>
    <sys:String x:Key="WinClose">X</sys:String>

</ResourceDictionary>