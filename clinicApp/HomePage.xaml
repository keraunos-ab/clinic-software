<Page x:Class="clinicApp.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:clinicApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Big centered welcome text -->
        <TextBox Text="Bienvenue sur le logiciel de la clinique du&#xD;&#xA;dr belhadj F !"
                 FontFamily="Constantia"
                 FontSize="42"
                 Foreground="White"
                 Background="#0077ff"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 IsReadOnly="True"
                 BorderThickness="0" Height="104" Width="746" />

        <!-- Smaller reminder below -->
        <TextBox Name="ApointmentReminder"
                 Text="Vous n'avez aucune rendez vous aujourd'hui"
                 FontFamily="Constantia"
                 FontSize="25"
                 Background="Transparent"
                 Foreground="#0077ff"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Width="504"
                 Grid.Row="1" Height="30" />
    </Grid>
</Page>
