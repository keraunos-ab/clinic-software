<Page x:Class="clinicApp.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:clinicApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentsPage">

    <Grid Background="Transparent">
        <ListView x:Name="AppointmentsList"
                  Margin="20"
                  Background="Transparent"
                  FontFamily="Constantia"
                  Foreground="White"
                  BorderThickness="0"
                  FontSize="16">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding PatientName}" Width="220"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" Width="170"/>
                    <GridViewColumn Header="L'heure" DisplayMemberBinding="{Binding Time}" Width="170"/>
                    <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Note}" Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
