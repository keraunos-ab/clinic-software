<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette aligned with MainWindow/HomePage -->
    <Color x:Key="Hint">#FF9AA4B2</Color>
    <Color x:Key="Text0">#FFF2F4F8</Color>
    <Color x:Key="Text1">#FFB8C0CC</Color>
    <Color x:Key="Blue0">#FF2F6FED</Color>

    <SolidColorBrush x:Key="Text0Brush" Color="{StaticResource Text0}" />
    <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1}" />
    <SolidColorBrush x:Key="HintBrush" Color="{StaticResource Hint}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Blue0}" />

    <!-- Card (same as HomePage CardStyle) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="34" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#10141C26" Offset="0" />
                    <GradientStop Color="#0B0F1622" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.45" Color="#FF000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Form building blocks -->
    <Style x:Key="FormTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Text0Brush}" />
    </Style>

    <Style x:Key="FormDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

</ResourceDictionary>