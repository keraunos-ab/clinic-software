<Page x:Class="clinicApp.AddPatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AddPatientPage"
        FontFamily="Segoe UI"
      Background="Transparent">

    <Page.Resources>
        <Color x:Key="CardBg">#FF131A24</Color>
        <Color x:Key="CardStroke">#22FFFFFF</Color>
        <Color x:Key="Hint">#FF9AA4B2</Color>
        <Color x:Key="Text0">#FFF2F4F8</Color>
        <Color x:Key="Text1">#FFB8C0CC</Color>

        <SolidColorBrush x:Key="Text0Brush" Color="{StaticResource Text0}" />
        <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1}" />
        <SolidColorBrush x:Key="HintBrush" Color="{StaticResource Hint}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStroke}" />

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text0Brush}" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#553D8BFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Text="Add New Patient"
                   Grid.Row="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource Text0Brush}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="First Name" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="PatientFirstName"
                     Style="{StaticResource InputBoxStyle}"
                     ToolTip="Enter patient's first name"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
            <TextBlock Text="Last Name" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="PatientLastName"
                     Style="{StaticResource InputBoxStyle}"
                     ToolTip="Enter patient's last name"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="Phone" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="Phone"
                     Style="{StaticResource InputBoxStyle}"
                     ToolTip="Enter patient's phone number"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="Email"
                     Style="{StaticResource InputBoxStyle}"
                     ToolTip="Enter patient's email"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="Note" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="Note"
                     Style="{StaticResource InputBoxStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="50"
                     ToolTip="Optional notes about the patient"/>
        </StackPanel>

        <Button Grid.Row="5" Grid.ColumnSpan="2"
                Content="Save"
                Background="#0077FF"
                Foreground="White"
                FontWeight="Bold"
                Height="40"
                Click="SavePatient_Click"/>
    </Grid>
</Page>
