<UserControl x:Class="clinicApp.PatientCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="Segoe UI"
             Margin="10"
             Width="450" Height="332">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="InlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="60" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="5,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text0Brush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <Grid Margin="-9,-9,-9,-9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: name + history button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Foreground="{DynamicResource Text0Brush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="18"
                               FontWeight="SemiBold" Width="231" Height="45"
                               ><Run Text="{Binding FirstName, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" /><Run Text="&#x0a;"/><Run Text="{Binding LastName, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" /></TextBlock>

                </StackPanel>

                <Button x:Name="HistoryButton"
                        Grid.Column="3"
                        Width="Auto"
                        MinWidth="60"
                        Padding="10,5"
                        HorizontalAlignment="Center"
                        Margin="5"
                        Content="{DynamicResource BtnHistory}"
                        Style="{StaticResource InlineButtonStyle}"
                        Click="HistoryButton_Click" />

                <Button x:Name="saveEditButton"
                        Width="Auto"
                        MinWidth="50"
                        Padding="10,5"
                        HorizontalAlignment="Center"
                        Margin="5"
                        Content="{DynamicResource BtnEdit}"
                        Style="{StaticResource InlineButtonStyle}"
                        Click="saveEditButton_Click" Grid.Column="1"/>

                <Button x:Name="DeleteButton"
                        Padding="10,5"
                        Width="Auto"
                        MinWidth="60"
                        HorizontalAlignment="Center"
                        Margin="5"
                        Content="{DynamicResource BtnDlt}"
                        Style="{StaticResource InlineButtonStyle}"
                        Background="#18E81123"
                        BorderBrush="#33E81123"
                        Click="DeleteButton_Click" Grid.Column="2" />
            </Grid>

            <!-- Contact chips -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="137*" />
                    <ColumnDefinition Width="269*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <Border Width="127" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource ChipStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelPhone}"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBox x:Name="PhoneTextBox"
                                 Text="{Binding Phone, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Foreground="{DynamicResource Text1Brush}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Width="110"
                                 FontSize="13"
                                 Margin="0,4,0,0"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" />
                    </StackPanel>
                </Border>

                <Border Width="281" HorizontalAlignment="Center" Grid.Column="1" Style="{StaticResource ChipStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelEmail}"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBox x:Name="EmailTextBox"
                                 Text="{Binding Email, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Foreground="{DynamicResource Text1Brush}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Margin="0,4,0,0"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Patient details chips -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="61*" />
                    <ColumnDefinition Width="43*" />
                    <ColumnDefinition Width="42*" />
                    <ColumnDefinition Width="60*" />
                </Grid.ColumnDefinitions>

                <Border HorizontalAlignment="Center" Style="{StaticResource ChipStyle}" Width="128">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelDob}"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding DateOfBirth, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=d}"
                                   Foreground="{DynamicResource Text1Brush}"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource ChipStyle}" Width="72" Margin="0,0,0,1">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.018"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelGender}"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding Gender, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="{DynamicResource Text1Brush}"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource ChipStyle}" Width="82" Margin="0,-1,0,1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelWeight}"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding Weight, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.#} kg, TargetNullValue=-}"
                                   Foreground="{DynamicResource Text1Brush}"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" HorizontalAlignment="Center" Style="{StaticResource ChipStyle}" Width="108" Margin="0,1,0,1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelBloodType}"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding BloodType, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="{DynamicResource Text1Brush}"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Note -->
            <Border Grid.Row="6"
                    CornerRadius="14"
                    Background="{DynamicResource TopBarChipBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="1"
                    Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LabelNote}"
                               Foreground="{DynamicResource HintBrush}"
                               FontSize="11" />
                    <TextBox x:Name="NoteTextBox"
                             Text="{Binding Note, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Foreground="{DynamicResource Text1Brush}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             Margin="0,6,0,0"
                             TextWrapping="Wrap"
                             MaxHeight="84"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
