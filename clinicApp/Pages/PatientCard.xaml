<UserControl x:Class="clinicApp.PatientCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="Segoe UI"
             Margin="10"
             Width="380">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="InlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="60" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text0Brush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: name + history button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="{DynamicResource Text0Brush}"
                               FontSize="16"
                               FontWeight="SemiBold" Width="Auto"
                               >
                        <Run Text="{Binding FirstName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Run Text="{Binding LastName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </TextBlock>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="History"
                        Style="{StaticResource InlineButtonStyle}"
                        Click="HistoryButton_Click" />
                
                <Button x:Name="saveEditButton"
                        Content="Edit"
                        Style="{StaticResource InlineButtonStyle}"
                        Click="saveEditButton_Click" Margin="212,0,10,0" />
            </Grid>

            <!-- Contact chips -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Width="110" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource ChipStyle}">
                    <StackPanel>
                        <TextBlock Text="Phone"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBox x:Name="PhoneTextBox"
                                 Text="{Binding Phone, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Foreground="{DynamicResource Text1Brush}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Margin="0,4,0,0"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" />
                    </StackPanel>
                </Border>

                <Border Width="228" HorizontalAlignment="Left" Grid.Column="1" Style="{StaticResource ChipStyle}" Grid.ColumnSpan="2">
                    <StackPanel>
                        <TextBlock Text="Email"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="11" />
                        <TextBox x:Name="EmailTextBox"
                                 Text="{Binding Email, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Foreground="{DynamicResource Text1Brush}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Margin="0,4,0,0"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Note -->
            <Border Grid.Row="4"
                    CornerRadius="14"
                    Background="{DynamicResource TopBarChipBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="1"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Note"
                               Foreground="{DynamicResource HintBrush}"
                               FontSize="11" />
                    <TextBox x:Name="NoteTextBox"
                             Text="{Binding Note, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Foreground="{DynamicResource Text1Brush}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             Margin="0,6,0,0"
                             TextWrapping="Wrap"
                             MaxHeight="84"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
