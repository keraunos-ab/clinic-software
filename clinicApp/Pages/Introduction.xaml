<Page x:Class="clinicApp.Pages.Introduction"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:clinicApp.Pages"
      mc:Ignorable="d"
        FontFamily="Segoe UI"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Introduction"
      Background="Transparent">

    <Page.Resources>
        <!-- Colors -->
        <Color x:Key="Bg0">#FF0B0F14</Color>
        <Color x:Key="CardBg">#FF131A24</Color>
        <Color x:Key="CardStroke">#22FFFFFF</Color>
        <Color x:Key="Hint">#FF9AA4B2</Color>
        <Color x:Key="Text0">#FFF2F4F8</Color>
        <Color x:Key="Text1">#FFB8C0CC</Color>
        <Color x:Key="Blue0">#FF2F6FED</Color>
        <Color x:Key="Blue1">#FF295FDD</Color>

        <SolidColorBrush x:Key="Text0Brush" Color="{StaticResource Text0}" />
        <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1}" />
        <SolidColorBrush x:Key="HintBrush" Color="{StaticResource Hint}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStroke}" />

        <!-- Common styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text0Brush}" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#553D8BFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}" />

                                <Path Grid.Column="1"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Fill="{StaticResource HintBrush}"
                                      Data="M 0 0 L 4 4 L 8 0 Z" />

                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Margin="0,8,0,0"
                                            Background="#FF141B25"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <ScrollViewer Margin="6" CanContentScroll="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#553D8BFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Blue0}" Offset="0" />
                                        <GradientStop Color="{StaticResource Blue1}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"
                                                      Color="#FF1A4ED8" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Dark background + subtle spotlight -->
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.25" Center="0.5,0.25" RadiusX="1.0" RadiusY="0.9">
                <GradientStop Color="#FF121826" Offset="0" />
                <GradientStop Color="{StaticResource Bg0}" Offset="0.55" />
                <GradientStop Color="#FF070A0F" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Centered card -->
        <Border Width="860"
                MaxWidth="900"
                Padding="40"
                CornerRadius="18"
                Background="#0F111827"
                BorderBrush="#1AFFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.45" Color="#FF000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock Text="Welcome! Please introduce yourself."
                               Foreground="{StaticResource Text0Brush}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="Enter your information below to personalize your clinic software."
                               Foreground="{StaticResource HintBrush}"
                               FontSize="14"
                               Margin="0,10,0,0"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Form -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="First Name" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="FirstNameTextBox" Style="{StaticResource InputBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Last Name" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="LastNameTextBox" Style="{StaticResource InputBoxStyle}" />
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Phone Number" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="PhoneTextBox" Style="{StaticResource InputBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="EmailTextBox" Style="{StaticResource InputBoxStyle}" />
                    </StackPanel>

                    <!-- Row 3 -->
                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="N° ordre" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="OrdreTextBox" Style="{StaticResource InputBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Doctor Specialty" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="SpecialtyTextBox" Style="{StaticResource InputBoxStyle}">
                        </TextBox>
                    </StackPanel>

                    <!-- Row 4 (full width) -->
                    <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Clinic Name" Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="ClinicNameTextBox" Style="{StaticResource InputBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 5 (full width) -->
                    <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
                        <StackPanel>
                            <TextBlock Text="Clinic Address" Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="ClinicAddressTextBox" Style="{StaticResource InputBoxStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Button -->
                <Button Grid.Row="5"
                        Content="Continue"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="420"
                        HorizontalAlignment="Center"
                        Click="ContinueButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
