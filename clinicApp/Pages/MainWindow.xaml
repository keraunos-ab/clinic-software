<Window x:Class="clinicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:clinicApp"
        mc:Ignorable="d"
        Title="Clinic Software"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Pictures/icon.png"
        d:DesignHeight="1080" d:DesignWidth="1920"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Main shell -->
    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>

        <Grid Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="14,12,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="10,0"
                        CornerRadius="14"
                        Background="{DynamicResource TopBarChipBrush}"
                        BorderBrush="{DynamicResource ChromeBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="18" Height="18" />
                        <TextBlock Margin="10,0,0,0"
                                   Foreground="{DynamicResource Text0Brush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1"
                           x:Name="TopBarDateTimeText"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Right"
                           Margin="0,10,185,0"
                           Foreground="{DynamicResource HintBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="—" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="🌙" Style="{DynamicResource TitleBarButton}" Click="ThemeButton_Click" />
                    <Button Content="—" Style="{DynamicResource TitleBarButton}" Click="MinimizeButton_Click" />
                    <Button Content="☐" Style="{DynamicResource TitleBarButton}" Click="MaximizeRestoreButton_Click" />
                    <Button Content="✕" Style="{DynamicResource CloseTitleBarButton}" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="14,12,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left nav card -->
                <Border Grid.Column="0"
                        Padding="18"
                        CornerRadius="18"
                        Background="#0F111827"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Clinic"
                                       Foreground="{StaticResource Text0Brush}"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Main menu"
                                       Foreground="{StaticResource HintBrush}"
                                       FontSize="13"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="NavHomeButton"
                                    Content="Home"
                                    Tag="⌂"
                                    IsDefault="True"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="HomeButton_Click" />

                            <Button x:Name="NavPatientsButton"
                                    Content="Patients"
                                    Tag="👥"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="PatientsButton_Click" />

                            <Button x:Name="NavAppointmentsButton"
                                    Content="Appointments"
                                    Tag="🗓"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="AppointmentsButton_Click" />

                            <Button x:Name="NavPrescriptionButton"
                                    Content="Prescriptions"
                                    Tag="💊"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="PrescriptionButton_Click" />

                            <Button x:Name="NavSettingsButton"
                                    Content="Settings"
                                    Tag="⚙"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="SettingsButton_Click" />
                        </StackPanel>

                        <Border Grid.Row="3"
                                Margin="0,16,0,0"
                                Padding="14"
                                CornerRadius="14"
                                Background="#0FFFFFFF"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tip"
                                           Foreground="{StaticResource Text0Brush}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Use the + button for quick actions."
                                           Foreground="{StaticResource HintBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content card -->
                <Border Grid.Column="2"
                        CornerRadius="18"
                        Background="#0F111827"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <Frame x:Name="MainFrame"
                               NavigationUIVisibility="Hidden"
                               Background="Transparent" />

                        <Button Content="+"
                                Style="{StaticResource FabStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,22,22"
                                Click="QuickAction_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>