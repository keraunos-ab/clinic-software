<Window x:Class="clinicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Clinic Software"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Pictures/icon.png"
        d:DesignHeight="1080" d:DesignWidth="1920"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Language Selector Style -->
        <Style x:Key="LanguageSelectorStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{DynamicResource TopBarChipBrush}"
                                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="{DynamicResource Text0Brush}"
                                                      StrokeThickness="1.5"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ToggleButton}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource TopBarChipBrush}"
                                        BorderBrush="{DynamicResource ChromeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Margin="0,4,0,0"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#FF000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main shell -->
    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>

        <Grid Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="14,12,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="10,0"
                        CornerRadius="14"
                        Background="{DynamicResource TopBarChipBrush}"
                        BorderBrush="{DynamicResource ChromeBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,0,0"
                                   Foreground="{DynamicResource Text0Brush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource AppTitle}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1"
                           x:Name="TopBarDateTimeText"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Right"
                           Margin="0,10,185,0"
                           Foreground="{DynamicResource HintBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{DynamicResource ClockPlaceholder}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector -->
                    <ComboBox x:Name="LanguageSelector"
                              Style="{StaticResource LanguageSelectorStyle}"
                              SelectedIndex="0"
                              SelectionChanged="LanguageSelector_SelectionChanged"
                              Margin="0,0,12,0">
                        <ComboBoxItem Style="{StaticResource LanguageItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇬🇧" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="English" VerticalAlignment="Center" Foreground="{DynamicResource Text0Brush}"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Style="{StaticResource LanguageItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇫🇷" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Français" VerticalAlignment="Center" Foreground="{DynamicResource Text0Brush}"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Style="{StaticResource LanguageItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇸🇦" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="العربية" VerticalAlignment="Center" Foreground="{DynamicResource Text0Brush}"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <ui:ToggleSwitch
                        x:Name="ThemeSwitch"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        IsChecked="False"
                        Click="ThemeToggle_Click">
                        <ui:ToggleSwitch.Template>
                            <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                                <Grid Width="75" Height="30" Background="Transparent" Cursor="Hand">
                                    <Border x:Name="Track" Background="#FF2F6FED" CornerRadius="15">
                                        <Grid>
                                            <Path x:Name="MoonIcon" Width="12" Height="12" Margin="8,0,0,0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                                                  Fill="White" Opacity="0" Stretch="Uniform" />
                                            <Path x:Name="SunIcon" Width="14" Height="14" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Data="M12 7A5 5 0 1 1 7 12A5 5 0 0 1 12 7Z M12 2V4 M12 20V22 M4 12H2 M20 12H22 M6.34 6.34L4.93 4.93 M19.07 19.07L17.66 17.66 M6.34 17.66L4.93 19.07 M19.07 4.93L17.66 6.34"
                                                  Stroke="White" StrokeThickness="2" Fill="Transparent" Opacity="1" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="Knob" Width="26" Height="26" Margin="2"
                                            HorizontalAlignment="Left" Background="White" CornerRadius="13">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" Direction="270" Opacity="0.3" ShadowDepth="1" />
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="KnobTranslate" X="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="45" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="SunIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="MoonIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="SunIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="MoonIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ui:ToggleSwitch.Template>
                    </ui:ToggleSwitch>

                    <Button Content="—" Style="{DynamicResource TitleBarButton}" Click="MinimizeButton_Click" />
                    <Button x:Name="maximize_button" Content="🗗" Style="{DynamicResource TitleBarButton}" Click="MaximizeRestoreButton_Click" />
                    <Button Content="✕" Style="{DynamicResource CloseTitleBarButton}" Background="#18e81123" BorderBrush="#33e81123" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="14,12,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left nav card -->
                <ScrollViewer>
                    <Border Grid.Column="0" Padding="18" CornerRadius="18"
                            Background="#0F111827" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <Image Source="/Pictures/placeHolderLogo.png" Height="80" Width="80"/>
                                <TextBlock x:Name="TitleText"
                                           Text="{DynamicResource ClinicTagline}"
                                           Foreground="{StaticResource Text1Brush}"
                                           FontSize="22" Height="Auto" FontWeight="SemiBold"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button x:Name="NavHomeButton"
                                        Content="{DynamicResource NavHome}"
                                        Tag="⌂" IsDefault="True"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="HomeButton_Click" />

                                <Button x:Name="NavPatientsButton"
                                        Content="{DynamicResource NavPatients}"
                                        Tag="👥"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="PatientsButton_Click" />

                                <Button x:Name="NavAppointmentsButton"
                                        Content="{DynamicResource NavAppointments}"
                                        Tag="🗓"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="AppointmentsButton_Click" />

                                <Button x:Name="NavPrescriptionButton"
                                        Content="{DynamicResource NavPrescriptions}"
                                        Tag="💊"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="PrescriptionButton_Click" />

                                <Button x:Name="NavSettingsButton"
                                        Content="{DynamicResource NavSettings}"
                                        Tag="⚙"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="SettingsButton_Click" />
                            </StackPanel>

                            <Border Grid.Row="3" Margin="0,16,0,0" Padding="14"
                                    CornerRadius="14" Background="Transparent" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource TipTitle}"
                                               Foreground="{StaticResource Text0Brush}"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource TipText}"
                                               Foreground="{StaticResource HintBrush}"
                                               FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Content card -->
                <Border Grid.Column="2" CornerRadius="18"
                        Background="#0F111827" BorderBrush="#1AFFFFFF" BorderThickness="1">
                    <Grid>
                        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="Transparent" />
                        <Button Content="+" Style="{StaticResource FabStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,22,22" Click="QuickAction_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>