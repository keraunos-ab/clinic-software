<Page x:Class="clinicApp.Pages.MedicalFolder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:clinicApp.Pages"
      mc:Ignorable="d"
      FontFamily="Segoe UI"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="MedicalFolder"
      Background="Transparent">

    <Page.Resources>
        <!-- ── Motif tab button (inactive) ── -->
        <Style x:Key="MotifTabButton" TargetType="Button">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Motif tab button (active / selected) ── -->
        <Style x:Key="MotifTabButtonActive" TargetType="Button" BasedOn="{StaticResource MotifTabButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Blue0}" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Back button ── -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Field label ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── Blue chip / badge ── -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Expander style ── -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text0Brush}"
                                                       VerticalAlignment="Center" />
                                            <Path x:Name="Arrow"
                                                  Data="M 0 0 L 5 5 L 10 0 Z"
                                                  Fill="{DynamicResource Text0Brush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,2,0,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent"
                                              Margin="0,6,0,0"
                                              Visibility="Visible" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Expander list item ── -->
        <Style x:Key="ExpanderItemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- ── Read-only blue chip field (Resultat bilan) ── -->
        <Style x:Key="ReadOnlyChipField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}" Width="Auto" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                    <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Large text area (Description diagnostique) ── -->
        <Style x:Key="DiagnosticTextArea" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardContainerBrush}"
                                BorderThickness="2">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource Blue0}" />
                            </Border.BorderBrush>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="PrintableArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ TAB BAR (pinned at top) ═══════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardContainerBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel x:Name="TabBar" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="TabMotifA" Content="Motiv A"
                        Style="{StaticResource MotifTabButtonActive}"
                        Click="MotifTab_Click" Tag="0" />
                <Button x:Name="TabMotifB" Content="Motiv B"
                        Style="{StaticResource MotifTabButton}"
                        Click="MotifTab_Click" Tag="1" />
                <Button x:Name="AddMotifBtn" Content="+"
                        Style="{StaticResource MotifTabButton}"
                        FontSize="24" FontWeight="Bold"
                        MinWidth="44" Width="44"
                        Click="AddMotifBtn_Click" />
            </StackPanel>
        </Border>

        <!-- ═══════ SCROLLABLE BODY ═══════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,20,36,36">

                <!-- ── Back arrow + patient title ── -->
                <DockPanel Margin="0,0,0,24">
                    <Button Style="{StaticResource BackButtonStyle}"
                            DockPanel.Dock="Left"
                            Click="BackButton_Click">
                        <TextBlock Text="←" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource Text0Brush}" />
                    </Button>
                    <Button Style="{StaticResource MotifTabButtonActive}"
                            DockPanel.Dock="Right"
                            Content="History"
                            Click="HistoryButton_Click" Width="Auto"/>
                    <TextBlock x:Name="PatientNameHeader"
                               Text="Patient firstname lastname 's medical record"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Text0Brush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </DockPanel>

                <!-- ── Etat Clinique ── -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <TextBlock Text="Etat Clinique :"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,14,0" />
                    <Border Style="{StaticResource ChipBorder}">
                        <TextBlock x:Name="EtatCliniqueText"
                                   Text="Diabetique"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- ── Medications (collapsible) ── -->
                <Expander IsExpanded="False" Header="Medications :" Style="{StaticResource SectionExpander}" Margin="0,0,0,20">
                    <StackPanel>
                        <BulletDecorator Margin="28,3,0,3">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                            </BulletDecorator.Bullet>
                            <TextBlock x:Name="Med1" Text="medication A" Style="{StaticResource ExpanderItemText}" />
                        </BulletDecorator>
                        <BulletDecorator Margin="28,3,0,3">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                            </BulletDecorator.Bullet>
                            <TextBlock x:Name="Med2" Text="medication B" Style="{StaticResource ExpanderItemText}" />
                        </BulletDecorator>
                        <BulletDecorator Margin="28,3,0,3">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                            </BulletDecorator.Bullet>
                            <TextBlock x:Name="Med3" Text="medication C" Style="{StaticResource ExpanderItemText}" />
                        </BulletDecorator>
                        <BulletDecorator Margin="28,3,0,3">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                            </BulletDecorator.Bullet>
                            <TextBlock x:Name="Med4" Text="medication D" Style="{StaticResource ExpanderItemText}" />
                        </BulletDecorator>
                    </StackPanel>
                </Expander>

                <!-- ── Antecedents (collapsible) ── -->
                <Expander IsExpanded="False" Header="Antecedents :" Style="{StaticResource SectionExpander}" Margin="0,0,0,24">
                    <StackPanel>
                        <BulletDecorator Margin="28,3,0,3">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                            </BulletDecorator.Bullet>
                            <TextBlock x:Name="Ant1" Text="Random surgery on dd/mm/yyyy"
                                       Style="{StaticResource ExpanderItemText}" />
                        </BulletDecorator>
                        <BulletDecorator Margin="28,3,0,3">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                            </BulletDecorator.Bullet>
                            <TextBlock x:Name="Ant2" Text="Blank accident on dd/mm/yyyy caused x y z injuries/illnesses"
                                       Style="{StaticResource ExpanderItemText}" />
                        </BulletDecorator>
                        <BulletDecorator Margin="28,3,0,3">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                            </BulletDecorator.Bullet>
                            <TextBlock x:Name="Ant3" Text="jsp cha ynejem ykon antecedent lssl"
                                       Style="{StaticResource ExpanderItemText}" />
                        </BulletDecorator>
                    </StackPanel>
                </Expander>

                <!-- ── Resultat bilan ── -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Resultat bilan :"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="ResultatBilanText"
                             Text="jsp franchement cha yji hna"
                             Style="{StaticResource ReadOnlyChipField}" />
                </StackPanel>

                <!-- ── Description diagnostique ── -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Description diagnostique"
                               Style="{StaticResource FieldLabel}"
                               Foreground="{DynamicResource Text0Brush}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="DescriptionDiagText"
                             Style="{StaticResource DiagnosticTextArea}"
                             Foreground="{DynamicResource Text0Brush}"
                             Text="voila hbibna 3ndh kda mena melhih khasah techrolah caviar w chwiya crevette chwiya calamar, katrolah l7am." />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>