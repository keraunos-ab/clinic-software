<Window x:Class="clinicApp.PatientHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:clinicApp.Models"
        Title="Patient History" FontFamily="Constantia" Height="500" Width="400" Background="#222">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Patient Name -->
            <RowDefinition Height="*"/>
            <!-- Scrollable Sessions -->
        </Grid.RowDefinitions>

        <!-- Patient Name -->
        <TextBlock x:Name="PatientNameTextBlock"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Right"
                   Margin="0,0,0,10"/>

        <!-- Sessions List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SessionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Session}">
                        <Border Background="#333"
                                CornerRadius="5"
                                BorderBrush="#0077FF"
                                BorderThickness="2"
                                Margin="0,0,0,10"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Date}" 
                                           FontWeight="SemiBold" 
                                           Foreground="White"/>
                                <TextBlock Text="{Binding Time}" 
                                           FontWeight="SemiBold" 
                                           Foreground="White"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Description}" 
                                           Foreground="White"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
