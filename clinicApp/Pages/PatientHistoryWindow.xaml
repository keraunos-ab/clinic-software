<Window x:Class="clinicApp.PatientHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:clinicApp.Models"
        Title="Patient History"
        FontFamily="Segoe UI"
        Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource HeaderTitle}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource HintBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="PatientNameTextBlock"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text0Brush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Sessions List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SessionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Session}">
                        <Border Background="{DynamicResource CardContainerBrush}"
                                CornerRadius="14"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,12"
                                Padding="16">
                            <StackPanel>
                                <!-- Date & Time Row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗓" 
                                                   Foreground="{DynamicResource HintBrush}" 
                                                   Margin="0,1,8,0"
                                                   FontSize="14"/>
                                        <TextBlock Text="{Binding Date}" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource Text0Brush}"
                                                   FontSize="14"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Time}" 
                                               Foreground="{DynamicResource HintBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </Grid>

                                <!-- Separator -->
                                <Rectangle Height="1" Fill="{DynamicResource ChromeBorderBrush}" Margin="0,0,0,10" />

                                <!-- Note/Description -->
                                <TextBlock Text="{Binding Description}" 
                                           Foreground="{DynamicResource Text1Brush}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
