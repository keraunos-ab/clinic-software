<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="clinicApp.PrescriptionPage"
      Title="PrescriptionPage"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="LabelText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="InputText" TargetType="{x:Type TextBox}">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F9FFFFFF"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="PrintableArea" Width="800" Height="1100">

            <Image Source="pack://application:,,,/Pictures/ordonnance.png"
                   Stretch="Fill"
                   Panel.ZIndex="0"/>

            <Canvas>
                <TextBlock x:Name="phone"
                           Text="0123456789"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           Background="Transparent"
                           TextAlignment="Center"
                           Width="360"
                           Canvas.Left="220"
                           Canvas.Top="970" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock x:Name="mail"
                        Text="waynebruce@wayneenterprise.com"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Background="Transparent"
                        TextAlignment="Center"
                        Width="594"
                        Canvas.Left="103"
                        Canvas.Top="994" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Text="Nom :"
                         Background="Transparent"
                           Style="{StaticResource LabelText}"
                           Canvas.Left="452"
                           Canvas.Top="181" HorizontalAlignment="Left" Width="159"/>
                <TextBox x:Name="FirstNameInput"
                         Style="{StaticResource InputText}"
                         Background="Transparent"
                         Canvas.Left="585"
                         Canvas.Top="177"
                         Width="205" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock Text="Prenom :"
                         Background="Transparent"
                           Style="{StaticResource LabelText}"
                           Canvas.Left="452"
                           Canvas.Top="214" HorizontalAlignment="Left" Width="159"/>
                <TextBox x:Name="LastNameInput"
                         Style="{StaticResource InputText}"
                         Background="Transparent"
                         Canvas.Left="585"
                         Canvas.Top="210"
                         Width="205" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock Text="Age :"
                           Style="{StaticResource LabelText}"
                         Background="Transparent"
                           Canvas.Left="452"
                           Canvas.Top="247" HorizontalAlignment="Left" Width="159"/>
                <TextBox x:Name="AgeInput"
                         Style="{StaticResource InputText}"
                         Background="Transparent"
                         Canvas.Left="585"
                         Canvas.Top="243"
                         Width="205" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock Text="Sexe :"
                           Style="{StaticResource LabelText}"
                         Background="Transparent"
                           Canvas.Left="452"
                           Canvas.Top="280" HorizontalAlignment="Left" Width="159"/>

                <ComboBox x:Name="SexInput"
                          Background="Transparent"
                          Canvas.Left="585"
                          Canvas.Top="276"
                          Width="205"
                          Height="37"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          FontSize="20"
                          SelectedIndex="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ComboBoxItem Content="Male" Background="Transparent"/>
                    <ComboBoxItem Content="Female" Background="Transparent"/>
                </ComboBox>

                <TextBlock Text="Oran le :"
                           Style="{StaticResource LabelText}"
                           Width="120"
                           Background="Transparent"
                           Canvas.Left="452"
                           Canvas.Top="315" HorizontalAlignment="Left"/>
                <TextBox x:Name="DateInput"
                         Style="{StaticResource InputText}"
                         Background="Transparent"
                         Canvas.Left="585"
                         Canvas.Top="311"
                         Width="205" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <StackPanel Canvas.Left="40" Canvas.Top="350" Width="720" HorizontalAlignment="Center" Height="685" VerticalAlignment="Top">
                    <ScrollViewer x:Name="MedicineScroll"
                                  Height="601"
                                  Background="#40FFFFFF"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <!-- Remove btn (35 width + 8 margin) -->
                                    <!-- Medicament -->
                                    <ColumnDefinition Width="1*"/>
                                    <!-- Dosage -->
                                    <ColumnDefinition Width="1.2*"/>
                                    <!-- N° boites -->
                                    <ColumnDefinition Width="1.2*"/>
                                    <!-- Poscologie -->
                                    <ColumnDefinition Width="43"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Medicament"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Dosage"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="N° boites"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Poscologie"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <!-- Column 4 reserved for remove button alignment -->
                            </Grid>

                            <StackPanel x:Name="MedicineList"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel
                Width="253" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                        <Button x:Name="AddMedicineButton"
                                Content="+"
                                Width="80"
                                Height="50"
                                FontSize="24"
                                FontWeight="Bold"
                                Click="AddMedicineButton_Click"
                                Margin="10,0"/>
                        <Button
                Width="140" x:Name="FinishButton" Margin="10,0" Height="50" FontSize="18" FontWeight="Bold" Content="Finish / Print" Click="FinishButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Doctor name: Dr + first + last -->
                <TextBlock x:Name="DoctorNameText"
                           Text="bruce wayne"
                           FontFamily="Constantia"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="Black"
                           Background="Transparent"
                           Width="490"
                           Height="42"
                           TextAlignment="Left"
                           Canvas.Left="10"
                           Canvas.Top="74" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock x:Name="Specialty"
                           Text="Caped crusador"
                           FontFamily="Constantia"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"
                           Background="Transparent"
                           Width="410"
                           Height="26"
                           TextAlignment="Left"
                           Canvas.Top="116" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Left="10"/>

                <TextBlock x:Name="adress"
                        Text="123, wayme street, gotham"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Background="Transparent"
                        TextAlignment="Center"
                        Width="540"
                        Canvas.Left="130"
                        Canvas.Top="1040" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="Patient :"
                        FontWeight="Bold"
                        Style="{StaticResource LabelText}"
                        Canvas.Left="649"
                        Canvas.Top="142" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBlock x:Name="N_order"
                           Text="N d'ordre : 4104"
                        FontFamily="Constantia"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="Black"
                        Background="Transparent"
                        Width="195"
                        Height="29"
                        TextAlignment="Left"
                        Canvas.Top="150" Canvas.Left="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Image x:Name="UserLogoWatermark"
                       Source="{Binding UserLogoImage, TargetNullValue='pack://application:,,,/Pictures/placeHolderLogo.png'}"
                       Width="580"
                       Height="604"
                       Opacity="0.6"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Canvas.Left="110"
                       Canvas.Top="240"
                       Panel.ZIndex="-1"/>
            </Canvas>
        </Grid>
    </Viewbox>
</Page>