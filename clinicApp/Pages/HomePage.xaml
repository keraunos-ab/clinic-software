<Page x:Class="clinicApp.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      FontFamily="Segoe UI"
      xmlns:local="clr-namespace:clinicApp"
      mc:Ignorable="d"
      Margin="0"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Home">

    <Grid Background="Transparent" Margin="28">
        <Border MinWidth="910"
                MinHeight="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="18"
                BorderThickness="1"
                Padding="34"
                Background="{DynamicResource HomePageCardBackgroundBrush}"
                BorderBrush="{DynamicResource HomePageCardBorderBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.45" Color="#FF000000" />
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top-right date/time -->
                <TextBlock Grid.Row="0"
                           x:Name="DateTimeText"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource HintBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="clock here" />

                <!-- Centered welcome -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Welcome back&#x0a;dr"
                               x:Name="WelcomeDr"
                               Foreground="{DynamicResource Text0Brush}"
                               FontSize="44"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Bottom-left appointments -->
                <TextBlock x:Name="AppointmentCounter"
                           Text="You have # appointment(s) today."
                           Grid.Row="2"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource Text1Brush}"
                           FontSize="22">
                </TextBlock>

                <TextBlock x:Name="SessionCouter"
                           Text="You did # session(s) today."
                           Grid.Row="2"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource Text1Brush}"
                           FontSize="22">
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>