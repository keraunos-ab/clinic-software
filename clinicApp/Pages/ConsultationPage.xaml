<Page x:Class="clinicApp.Pages.ConsultationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:clinicApp.Pages"
      mc:Ignorable="d"
      FontFamily="Segoe UI"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ConsultationPage"
      Background="Transparent">

    <Page.Resources>
        <!-- ── Search box ── -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavActiveBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text0Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Search result list item ── -->
        <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Consultation tab button (inactive) ── -->
        <Style x:Key="ConsultationTabButton" TargetType="Button">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Consultation tab button (active / selected) ── -->
        <Style x:Key="ConsultationTabButtonActive" TargetType="Button" BasedOn="{StaticResource ConsultationTabButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Blue0}" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Back button ── -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Field label ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── Blue chip / badge ── -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Expander style ── -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text0Brush}"
                                                       VerticalAlignment="Center" />
                                            <Path x:Name="Arrow"
                                                  Data="M 0 0 L 5 5 L 10 0 Z"
                                                  Fill="{DynamicResource Text0Brush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,2,0,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent"
                                              Margin="0,6,0,0"
                                              Visibility="Visible" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Expander list item ── -->
        <Style x:Key="ExpanderItemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- ── Read-only blue chip field (Resultat bilan) ── -->
        <Style x:Key="ReadOnlyChipField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}" Width="Auto" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                    <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Large text area (Description diagnostique) ── -->
        <Style x:Key="DiagnosticTextArea" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource TopBarChipBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="2">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="PrintableArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ SEARCH BAR ═══════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardContainerBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource PatientsTitle}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text0Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <Grid Grid.Column="1" x:Name="SearchContainer" MaxWidth="460" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource SearchBoxStyle}"
                             TextChanged="SearchTextBox_TextChanged" />
                    <Popup x:Name="SearchPopup"
                           PlacementTarget="{Binding ElementName=SearchTextBox}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Width="{Binding ActualWidth, ElementName=SearchTextBox}">
                        <Border Background="{DynamicResource CardContainerBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                MaxHeight="220">
                            <ListBox x:Name="SearchResultsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                     SelectionChanged="SearchResultsList_SelectionChanged" />
                        </Border>
                    </Popup>
                </Grid>

                <Grid Grid.Column="2" x:Name="BirthdateSearchContainer" MaxWidth="300" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBox x:Name="BirthdateSearchTextBox"
                             Style="{StaticResource SearchBoxStyle}"
                             TextChanged="BirthdateSearchTextBox_TextChanged" />
                    <TextBlock IsHitTestVisible="False"
                               Text="dd/mm/yyyy"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource HintBrush}"
                               FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BirthdateSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup x:Name="BirthdateSearchPopup"
                           PlacementTarget="{Binding ElementName=BirthdateSearchTextBox}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Width="{Binding ActualWidth, ElementName=BirthdateSearchTextBox}">
                        <Border Background="{DynamicResource CardContainerBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                MaxHeight="220">
                            <ListBox x:Name="BirthdateSearchResultsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                     SelectionChanged="BirthdateSearchResultsList_SelectionChanged" />
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════ CONSULTATION AREA (hidden until a patient is selected) ═══════ -->
        <Grid x:Name="ConsultationArea" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══════ TAB BAR (pinned at top) ═══════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardContainerBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <StackPanel x:Name="TabBar" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="AddConsultationBtn" Content="+"
                            Style="{StaticResource ConsultationTabButton}"
                            FontSize="24" FontWeight="Bold"
                            MinWidth="44" Width="44"
                            Click="AddConsultationBtn_Click" />
                </StackPanel>
            </Border>

            <!-- ═══════ SCROLLABLE BODY ═══════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,20,36,36">

                    <!-- ── Back arrow + patient title ── -->
                    <DockPanel Margin="0,0,0,24">
                        <Button Style="{StaticResource BackButtonStyle}"
                                DockPanel.Dock="Left"
                                Click="BackButton_Click">
                            <TextBlock Text="←" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource Text0Brush}" />
                        </Button>
                        <Button Style="{StaticResource ConsultationTabButtonActive}"
                                DockPanel.Dock="Right"
                                Content="{DynamicResource BtnHistory2}"
                                Click="ConsultationHistoryButton_Click" Width="Auto"/>
                        <Button Style="{StaticResource ConsultationTabButtonActive}"
                                DockPanel.Dock="Right"
                                Content="{DynamicResource BtnFullHistory}"
                                Click="FullHistoryButton_Click" Width="Auto" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PatientNameHeader"
                                   Text=""
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Text0Brush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </DockPanel>

                    <!-- ── Motiv ── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource LabelMotiv}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,14,0" />
                        <Border Style="{StaticResource ChipBorder}">
                            <TextBlock x:Name="MotivText"
                                       Text=""
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- ── Bilan ── -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource LabelBilan}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8" />
                        <Border x:Name="BilanImageBorder"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="2"
                                Background="{DynamicResource CardContainerBrush}"
                                Padding="10"
                                MaxHeight="300">
                            <Image x:Name="BilanImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="BilanImage_MouseLeftButtonDown" />
                        </Border>
                    </StackPanel>

                    <!-- ── Antecedents (collapsible) ── -->
                    <Expander IsExpanded="False" Header="{DynamicResource LabelAntecedents}" Style="{StaticResource SectionExpander}" Margin="0,0,0,20">
                        <StackPanel x:Name="AntecedentsPanel" />
                    </Expander>

                    <!-- ── Medications (collapsible) ── -->
                    <Expander IsExpanded="False" Header="{DynamicResource LabelMedications}" Style="{StaticResource SectionExpander}" Margin="0,0,0,24">
                        <StackPanel x:Name="MedicationsPanel" />
                    </Expander>

                    <!-- ── HDM (Histoire de la Maladie) ── -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource LabelHDM}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="HDMText"
                                 Text=""
                                 IsReadOnly="True"
                                 Foreground="{DynamicResource Text0Brush}"
                                 Background="{DynamicResource TopBarChipBrush}"
                                 BorderBrush="{DynamicResource ChromeBorderBrush}"
                                 BorderThickness="2"
                                 Padding="14,10"
                                 VerticalContentAlignment="Center"
                                 Height="40"/>
                    </StackPanel>

                    <!-- ── Etat Clinique ── -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource LabelEtatClinique}"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{DynamicResource Text0Brush}"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="EtatCliniqueText"
                                 Style="{StaticResource DiagnosticTextArea}"
                                 Foreground="{DynamicResource Text0Brush}"
                                 Text="" />
                    </StackPanel>

                    <!-- ── CAT (Conduite à Tenir) ── -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource LabelCAT}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="CATText"
                                 Text=""
                                 IsReadOnly="True"
                                 Foreground="{DynamicResource Text0Brush}"
                                 Background="{DynamicResource TopBarChipBrush}"
                                 BorderBrush="{DynamicResource ChromeBorderBrush}"
                                 BorderThickness="2"
                                 Padding="14,10"
                                 VerticalContentAlignment="Center"
                                 Height="40"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════ EMPTY STATE (shown until a patient is selected) ═══════ -->
        <Border Grid.Row="1" Grid.RowSpan="2" x:Name="EmptyState" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                <TextBlock Text="🔍"
                           FontSize="48"
                           Foreground="{DynamicResource Text0Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource PatientsSearchHint}"
                           FontSize="15"
                           Foreground="{DynamicResource HintBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
