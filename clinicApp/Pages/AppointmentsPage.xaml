<Page x:Class="clinicApp.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:clinicApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentsPage"
                       FontFamily="Constantia">

    <Grid Background="#1e1e1e">
        <ListView x:Name="AppointmentsList"
                  Margin="20"
                  Background="#2d2d2d"
                  Foreground="White"
                  BorderThickness="0"
                  FontSize="16">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding PatientName}" Width="180"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" Width="120"/>
                    <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="120"/>
                    <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Note}" Width="250"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
