<Page x:Class="clinicApp.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:clinicApp.Pages"
      mc:Ignorable="d"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Settings"
      FontFamily="Segoe UI"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Dark palette (default) -->
        <Color x:Key="DarkBg0">#FF0B0F14</Color>
        <Color x:Key="DarkCardBg">#FF131A24</Color>
        <Color x:Key="DarkCardStroke">#22FFFFFF</Color>
        <Color x:Key="DarkHint">#FF9AA4B2</Color>
        <Color x:Key="DarkText0">#FFF2F4F8</Color>
        <Color x:Key="DarkText1">#FFB8C0CC</Color>

        <!-- Active brushes -->
        <SolidColorBrush x:Key="Text0Brush" Color="{StaticResource DarkText0}" />
        <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource DarkText1}" />
        <SolidColorBrush x:Key="HintBrush" Color="{StaticResource DarkHint}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource DarkCardBg}" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource DarkCardStroke}" />

        <!-- Background brushes -->
        <RadialGradientBrush x:Key="DarkBackgroundBrush" GradientOrigin="0.5,0.25" Center="0.5,0.25" RadiusX="1.0" RadiusY="0.9">
            <GradientStop Color="#FF121826" Offset="0" />
            <GradientStop Color="{StaticResource DarkBg0}" Offset="0.55" />
            <GradientStop Color="#FF070A0F" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="LightBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFFF" Offset="0" />
            <GradientStop Color="#FFE5E9EF" Offset="1" />
        </LinearGradientBrush>

        <!-- Common styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text0Brush}" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#553D8BFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF2F6FED" Offset="0" />
                                        <GradientStop Color="#FF295FDD" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"
                                                      Color="#FF1A4ED8" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource DarkBackgroundBrush}" Margin="28">
        <Border Width="900"
                MaxWidth="900"
                Padding="40"
                CornerRadius="18"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardStrokeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.45" Color="#FF000000" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                    <!-- Header -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,18">
                        <TextBlock Text="Settings"
                                   Foreground="{StaticResource Text0Brush}"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Update your credentials and choose between light or dark mode."
                                   Foreground="{StaticResource HintBrush}"
                                   FontSize="14"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Fieldset: User credentials -->
                    <Border Margin="0,0,0,18"
                            Padding="22"
                            CornerRadius="14"
                            Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource CardBgBrush}"
                                    Padding="6,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6"
                                    BorderBrush="{StaticResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    Margin="6,-18,0,8">
                                <TextBlock Text="User credentials"
                                           Foreground="{StaticResource Text0Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Vertical">
                                <StackPanel>
                                    <TextBlock Text="First Name" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="FirstNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Last Name" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="LastNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Phone Number" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="PhoneTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="EmailTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="N° ordre" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="OrdreTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Doctor Specialty" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="SpecialtyTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Clinic Name" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ClinicNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Clinic Address" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ClinicAddressTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>

                                <Button Content="Save changes"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="200"
                                        Margin="0,6,0,0"
                                        Click="SaveCredentialsButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Changes here override the information provided during introduction."
                               Foreground="{StaticResource HintBrush}"
                               FontSize="12"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
