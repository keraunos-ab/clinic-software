<Page x:Class="clinicApp.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:clinicApp.Pages"
      mc:Ignorable="d"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Settings"
      FontFamily="Segoe UI"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Common styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Blue0}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"
                                                      Color="#FF1A4ED8" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackgroundBrush}" Margin="28">
        <Border Width="900"
                MaxWidth="900"
                Padding="40"
                CornerRadius="18"
                Background="Transparent"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.45" Color="#FF000000" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                    <!-- Header -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,18">
                        <TextBlock Text="Settings"
                                   Foreground="{DynamicResource Text0Brush}"
                                   FontSize="32"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Update your credentials"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="16"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Fieldset: User credentials -->
                    <Border Margin="0,0,0,18"
                            Padding="22"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource CardBgBrush}"
                                    Padding="6,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    Margin="6,-18,0,8">
                                <TextBlock Text="User credentials"
                                           Foreground="{DynamicResource Text0Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Vertical">
                                <StackPanel>
                                    <TextBlock Text="First Name" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="FirstNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Last Name" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="LastNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Phone Number" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="PhoneTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="EmailTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="N° ordre" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="OrdreTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Doctor Specialty" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="SpecialtyTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Clinic Name" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ClinicNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Clinic Address" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ClinicAddressTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>

                                <Button Content="Save changes"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="200"
                                        Margin="30"
                                        Click="SaveCredentialsButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Changes here override the information provided during introduction."
                               Foreground="{DynamicResource HintBrush}"
                               FontSize="12"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
