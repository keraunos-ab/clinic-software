<Page x:Class="clinicApp.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:clinicApp.Pages"
      mc:Ignorable="d"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Settings"
      FontFamily="Segoe UI"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="rectangle"
                            Background="{DynamicResource ScrollBarThumbBrush}"
                            Opacity="0.3" 
                            CornerRadius="4"
                            Margin="2,0,2,0"
                            SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="rectangle" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Blue0}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"
                                                      Color="#FF1A4ED8" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource PageBackgroundBrush}" Margin="28">
        <Border Width="1000"
                Padding="10"
                CornerRadius="18"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                    <!-- Header -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,18">
                        <TextBlock Text="{DynamicResource SettingsHeader}"
                                   Foreground="{DynamicResource Text0Brush}"
                                   FontSize="32"
                                   Padding="40,40,0,0"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource SettingsSubtitle}"
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="16"
                                   Padding="40,0,0,0"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Fieldset: User credentials -->
                    <Border Margin="0"
                            Width="Auto"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource CardBgBrush}"
                                    Padding="6,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    Margin="6,-18,0,8">
                                <TextBlock Text="{DynamicResource SettingsSectionTitle}"
                                           Foreground="{DynamicResource Text0Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Vertical">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelFirstName}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="FirstNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelLastName}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="LastNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelPhone}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="PhoneTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelEmail}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="EmailTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelOrdre}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="OrdreTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelSpecialty}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="SpecialtyTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelClinicName}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ClinicNameTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LabelClinicAddress}" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ClinicAddressTextBox" Style="{StaticResource InputBoxStyle}" />
                                </StackPanel>

                                <!-- Clinic Logo Section -->
                                <StackPanel Margin="0,18,0,0">
                                    <TextBlock Text="{DynamicResource LabelLogo}" Style="{StaticResource LabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Logo Preview -->
                                        <Border Grid.Column="0"
                                                Width="80"
                                                Height="80"
                                                CornerRadius="12"
                                                Background="{DynamicResource CardContainerBrush}"
                                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                BorderThickness="1">
                                            <Image x:Name="LogoPreviewImage"
                                                   Stretch="Uniform"
                                                   Margin="8" />
                                        </Border>
                                        
                                        <!-- Browse Button and File Name -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="LogoBrowseButton"
                                                    Content="{DynamicResource BtnBrowseLogo}"
                                                    Foreground="{DynamicResource Text0Brush}"
                                                    Height="44"
                                                    Width="200"
                                                    HorizontalAlignment="Left"
                                                    Cursor="Hand"
                                                    Click="BrowseLogoButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource CardContainerBrush}"
                                                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                                BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock x:Name="LogoFileNameText"
                                                       Foreground="{DynamicResource HintBrush}"
                                                       FontSize="12"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Button Content="{DynamicResource BtnSaveChanges}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="200"
                                        Margin="30"
                                        Click="SaveCredentialsButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fieldset: Password Protection -->
                    <Border Margin="0,0,0,18"
                            Width="Auto"
                            Padding="22"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource CardBgBrush}"
                                    Padding="6,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    Margin="6,-18,0,8">
                                <TextBlock Text="{DynamicResource PasswordSectionTitle}"
                                           Foreground="{DynamicResource Text0Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Vertical">
                                <!-- Enable Password Toggle -->
                                <Grid Margin="0,10,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LabelEnablePassword}"
                                               Foreground="{DynamicResource Text1Brush}"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                    
                                    <ToggleButton x:Name="PasswordToggle"
                                                  Grid.Column="1"
                                                  Width="60"
                                                  Height="30"
                                                  Cursor="Hand"
                                                  Click="PasswordToggle_Click">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="Track"
                                                            Background="{DynamicResource CardContainerBrush}"
                                                            BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="15" />
                                                    <Border x:Name="Knob"
                                                            Width="24"
                                                            Height="24"
                                                            Margin="3"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource HintBrush}"
                                                            CornerRadius="12">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="KnobTranslate" X="0" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Track" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                                                    <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Knob" Property="Background" Value="White" />
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="KnobTranslate"
                                                                                     Storyboard.TargetProperty="X"
                                                                                     To="30" Duration="0:0:0.2" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="KnobTranslate"
                                                                                     Storyboard.TargetProperty="X"
                                                                                     To="0" Duration="0:0:0.2" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>

                                <!-- Password Fields Panel (shown when password is being set/changed) -->
                                <StackPanel x:Name="PasswordFieldsPanel" Visibility="Collapsed">
                                    <!-- Current Password (for changing/removing) -->
                                    <StackPanel x:Name="CurrentPasswordPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource LabelCurrentPassword}" Style="{StaticResource LabelStyle}" />
                                        <PasswordBox x:Name="CurrentPasswordBox" Height="44" Padding="14,0,14,0"
                                                     FontSize="14">
                                            <PasswordBox.Template>
                                                <ControlTemplate TargetType="PasswordBox">
                                                    <Grid>
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource CardContainerBrush}"
                                                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10" />
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="{DynamicResource Blue0}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </PasswordBox.Template>
                                        </PasswordBox>
                                    </StackPanel>

                                    <!-- New Password -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource LabelNewPassword}" Style="{StaticResource LabelStyle}" />
                                        <PasswordBox x:Name="NewPasswordBox" Height="44" Padding="14,0,14,0"
                                                     FontSize="14">
                                            <PasswordBox.Template>
                                                <ControlTemplate TargetType="PasswordBox">
                                                    <Grid>
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource CardContainerBrush}"
                                                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10" />
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="{DynamicResource Blue0}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </PasswordBox.Template>
                                        </PasswordBox>
                                    </StackPanel>

                                    <!-- Confirm Password -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource LabelConfirmPassword}" Style="{StaticResource LabelStyle}" />
                                        <PasswordBox x:Name="ConfirmPasswordBox" Height="44" Padding="14,0,14,0"
                                                     FontSize="14">
                                            <PasswordBox.Template>
                                                <ControlTemplate TargetType="PasswordBox">
                                                    <Grid>
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource CardContainerBrush}"
                                                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10" />
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="{DynamicResource Blue0}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </PasswordBox.Template>
                                        </PasswordBox>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                        <Button x:Name="SetPasswordButton"
                                                Content="{DynamicResource BtnSetPassword}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Width="180"
                                                Margin="0,0,10,0"
                                                Click="SetPasswordButton_Click" />
                                        
                                        <Button x:Name="RemovePasswordButton"
                                                Content="{DynamicResource BtnRemovePassword}"
                                                Width="180"
                                                Height="52"
                                                Cursor="Hand"
                                                Visibility="Collapsed"
                                                Click="RemovePasswordButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            CornerRadius="12"
                                                            Background="{DynamicResource CardContainerBrush}"
                                                            BorderBrush="{DynamicResource ChromeBorderBrush}"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE53935" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{DynamicResource SettingsFooter}"
                               Foreground="{DynamicResource HintBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               Padding="10"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
