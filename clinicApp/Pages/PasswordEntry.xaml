<Window x:Class="clinicApp.Pages.PasswordEntry"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:clinicApp.Pages"
        mc:Ignorable="d"
        Title="{DynamicResource PasswordEntryTitle}"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="16,0,16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Blue0}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnlockButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"
                                                      Color="#FF1A4ED8" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource PasswordEntryHeader}"
                       Foreground="{DynamicResource Text0Brush}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource PasswordEntrySubtitle}"
                       Foreground="{DynamicResource HintBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,30"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />

            <!-- Password Label -->
            <TextBlock Grid.Row="2"
                       Text="{DynamicResource PasswordEntryLabel}"
                       Foreground="{DynamicResource Text1Brush}"
                       FontSize="13"
                       Margin="0,0,0,8" />

            <!-- Password Box -->
            <PasswordBox Grid.Row="3"
                         x:Name="PasswordBox"
                         Style="{StaticResource PasswordBoxStyle}"
                         KeyDown="PasswordBox_KeyDown" />

            <!-- Error Message -->
            <TextBlock Grid.Row="4"
                       x:Name="ErrorMessage"
                       Foreground="#FFE53935"
                       FontSize="13"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"
                       Text="{DynamicResource PasswordIncorrect}" />

            <!-- Unlock Button -->
            <Button Grid.Row="5"
                    Content="{DynamicResource BtnUnlock}"
                    Style="{StaticResource UnlockButtonStyle}"
                    Width="200"
                    VerticalAlignment="Bottom"
                    Margin="0,20,0,0"
                    Click="UnlockButton_Click" />
        </Grid>
    </Border>
</Window>
