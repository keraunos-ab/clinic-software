<Page x:Class="clinicApp.AddSessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AddSessionPage"
      FontFamily="Segoe UI"
      Background="Transparent">

    <Page.Resources>
        <Color x:Key="CardBg">#FF131A24</Color>
        <Color x:Key="CardStroke">#22FFFFFF</Color>
        <Color x:Key="Hint">#FF9AA4B2</Color>
        <Color x:Key="Text0">#FFF2F4F8</Color>
        <Color x:Key="Text1">#FFB8C0CC</Color>

        <SolidColorBrush x:Key="Text0Brush" Color="{StaticResource Text0}" />
        <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1}" />
        <SolidColorBrush x:Key="HintBrush" Color="{StaticResource Hint}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStroke}" />

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text0Brush}" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#553D8BFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Add New Session"
                   Grid.Row="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource Text0Brush}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0"/>

        <!-- Patient Search (Prescription-like: TextBox + Popup) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="Patient First Name" Style="{StaticResource LabelStyle}" />

            <Grid>
                <TextBox x:Name="PatientSearchBox"
                         Style="{StaticResource InputBoxStyle}"
                         ToolTip="Type to search patients"
                         TextChanged="PatientSearchBox_TextChanged"
                         PreviewKeyDown="PatientSearchBox_PreviewKeyDown"/>

                <Popup x:Name="PatientPopup"
                       PlacementTarget="{Binding ElementName=PatientSearchBox}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Margin="0,8,0,0"
                            Background="#FF141B25"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="6">
                        <ListBox x:Name="PatientResultsList"
                                 Width="380"
                                 MaxHeight="220"
                                 FontSize="12"
                                 DisplayMemberPath="FullName"
                                 MouseLeftButtonUp="PatientResultsList_MouseLeftButtonUp"/>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
            <TextBlock Text="Patient Last Name" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="PatientLastName"
                     Style="{StaticResource InputBoxStyle}"
                     ToolTip="Patient last name will auto-fill"
                     IsReadOnly="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="Date" Style="{StaticResource LabelStyle}" />
            <DatePicker x:Name="SessionDate"
                        Height="44"
                        ToolTip="Select session date"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
            <TextBlock Text="Time" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="SessionTime"
                     Style="{StaticResource InputBoxStyle}"
                     ToolTip="Enter time (e.g. 14:30)"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="Description" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="Description"
                     Style="{StaticResource InputBoxStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="50"
                     ToolTip="Optional note about the session"/>
        </StackPanel>

        <Button Grid.Row="5" Grid.ColumnSpan="2"
                Content="Save"
                Background="#0077FF"
                Foreground="White"
                FontWeight="Bold"
                Height="40"
                Click="SaveSession_Click"/>
    </Grid>
</Page>