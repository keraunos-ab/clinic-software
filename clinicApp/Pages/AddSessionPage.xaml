<Page x:Class="clinicApp.AddSessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AddSessionPage"
      FontFamily="Segoe UI"
      Background="Transparent">

    <Page.Resources>
        <!-- Common styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Blue0}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource CardContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Blue0}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"
                                                      Color="#FF1A4ED8" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,0,10,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{DynamicResource AddSessionHeader}"
                       Grid.Row="0" Grid.ColumnSpan="2"
                       Foreground="{StaticResource Text0Brush}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0"/>

            <!-- Patient Search (Prescription-like: TextBox + Popup) -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="{DynamicResource LabelPatientFirstName}" Style="{StaticResource LabelStyle}" />

                <Grid>
                    <TextBox x:Name="PatientSearchBox"
                             Style="{StaticResource InputBoxStyle}"
                             ToolTip="{DynamicResource ToolTipSearchPatients}"
                             TextChanged="PatientSearchBox_TextChanged"
                             PreviewKeyDown="PatientSearchBox_PreviewKeyDown"/>

                    <Popup x:Name="PatientPopup"
                           PlacementTarget="{Binding ElementName=PatientSearchBox}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Margin="0,8,0,0"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6">
                            <ListBox x:Name="PatientResultsList"
                                     Width="380"
                                     MaxHeight="220"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Text0Brush}"
                                     DisplayMemberPath="FullName"
                                     MouseLeftButtonUp="PatientResultsList_MouseLeftButtonUp"/>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                <TextBlock Text="{DynamicResource LabelPatientLastName}" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="PatientLastName"
                         Style="{StaticResource InputBoxStyle}"
                         ToolTip="{DynamicResource ToolTipLastNameAutoFill}"
                         IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="{DynamicResource LabelDate}" Style="{StaticResource LabelStyle}" />
                <Border Style="{StaticResource InputBorderStyle}">
                    <DatePicker x:Name="SessionDate"
                                VerticalContentAlignment="Center"
                                Foreground="{DynamicResource Text0Brush}"
                                BorderThickness="0"
                                Background="Transparent">
                        <DatePicker.Resources>
                            <Style TargetType="{x:Type DatePickerTextBox}">
                                <Setter Property="Foreground" Value="{DynamicResource Text0Brush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              Margin="14,0,0,0" 
                                                              VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                <TextBlock Text="{DynamicResource LabelTime}" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="SessionTime"
                         Style="{StaticResource InputBoxStyle}"
                         ToolTip="{DynamicResource ToolTipEnterTime}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource LabelDescription}" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="Description"
                         Style="{StaticResource InputBoxStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="130"
                         ToolTip="{DynamicResource ToolTipDescription}"/>
            </StackPanel>

            <Button Grid.Row="5" Grid.ColumnSpan="2"
                    Content="{DynamicResource BtnSave}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    Click="SaveSession_Click"/>
        </Grid>
    </ScrollViewer>
</Page>