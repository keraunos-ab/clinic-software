<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main palette -->
    <Color x:Key="Bg0">#FF0B0F14</Color>
    <Color x:Key="Bg1">#FF121826</Color>
    <Color x:Key="CardBg">#FF131A24</Color>
    <Color x:Key="CardStroke">#22FFFFFF</Color>
    <Color x:Key="Hint">#FF9AA4B2</Color>
    <Color x:Key="Text0">#FFF2F4F8</Color>
    <Color x:Key="Text1">#FFB8C0CC</Color>
    <Color x:Key="Blue0">#FF2F6FED</Color>
    <Color x:Key="Blue1">#FF295FDD</Color>

    <!-- Brushes (DynamicResource so they live-update) -->
    <SolidColorBrush x:Key="Text0Brush" Color="{DynamicResource Text0}" />
    <SolidColorBrush x:Key="Text1Brush" Color="{DynamicResource Text1}" />
    <SolidColorBrush x:Key="HintBrush" Color="{DynamicResource Hint}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{DynamicResource CardBg}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{DynamicResource CardStroke}" />

    <!-- Common chrome brushes used by MainWindow -->
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CardContainerBrush" Color="#0F111827" />
    <SolidColorBrush x:Key="TopBarChipBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonBgBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonBorderBrush" Color="#1FFFFFFF" />

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="HoverOverlaySoftBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlaySoftBrush" Color="#16FFFFFF" />

    <!-- Nav active/indicator -->
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#141A4ED8" />
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#2A3D8BFF" />
    <SolidColorBrush x:Key="NavActiveAccentBrush" Color="#FF3D8BFF" />

    <!-- MainWindow background -->
    <RadialGradientBrush x:Key="WindowBackgroundBrush"
                         GradientOrigin="0.5,0.18"
                         Center="0.5,0.18"
                         RadiusX="1.1"
                         RadiusY="0.95">
        <GradientStop Color="{DynamicResource Bg1}" Offset="0" />
        <GradientStop Color="{DynamicResource Bg0}" Offset="0.55" />
        <GradientStop Color="#FF070A0F" Offset="1" />
    </RadialGradientBrush>

    <!-- ScrollBar thumb -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#4AFFFFFF" />

    <LinearGradientBrush x:Key="HomePageCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#10141C26" Offset="0" />
        <GradientStop Color="#0B0F1622" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HomePageCardBorderBrush" Color="#1FFFFFFF" />

    <!-- Global ScrollBar style -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb MinHeight="30">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="Bd"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource ScrollBarThumbBrush}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollBarThumbDraggingBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar buttons -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource TitleBarButtonBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBarButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseTitleBarButton"
           TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource TitleBarButtonBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBarButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nav button -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Accent"
                                    Grid.Column="0"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="Transparent" />

                            <TextBlock Grid.Column="0"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource HintBrush}"
                                       Text="{TemplateBinding Tag}" />

                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlaySoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlaySoftBrush}" />
                        </Trigger>

                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBgBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavActiveBorderBrush}" />
                            <Setter TargetName="Accent" Property="Background" Value="{DynamicResource NavActiveAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Floating action button -->
    <Style x:Key="FabStyle" TargetType="Button">
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="58" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="29">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                    <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.40" Color="#FF1A4ED8" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>