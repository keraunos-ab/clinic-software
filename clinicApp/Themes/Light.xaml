<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Keep SAME KEYS, different values -->
    <Color x:Key="Bg0">#FFD4E2F3</Color>
    <Color x:Key="Bg1">#FFFFF5F9</Color>
    <Color x:Key="CardBg">#FFFFFFFF</Color>
    <Color x:Key="CardStroke">#22000000</Color>
    <Color x:Key="Hint">#FF475569</Color>
    <Color x:Key="Text0">#FF0F172A</Color>
    <Color x:Key="Text1">#FF334155</Color>
    <Color x:Key="Blue0">#FF4B8BF5</Color>
    <Color x:Key="Blue1">#FF2563EB</Color>

    <SolidColorBrush x:Key="Text0Brush" Color="{DynamicResource Text0}" />
    <SolidColorBrush x:Key="Text1Brush" Color="{DynamicResource Text1}" />
    <SolidColorBrush x:Key="HintBrush" Color="{DynamicResource Hint}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{DynamicResource CardBg}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{DynamicResource CardStroke}" />

    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="CardContainerBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="TopBarChipBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonBgBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonBorderBrush" Color="#1A000000" />

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="HoverOverlaySoftBrush" Color="#08000000" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#14000000" />
    <SolidColorBrush x:Key="PressedOverlaySoftBrush" Color="#12000000" />

    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#FF6495ED" />
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#FF6495ED" />
    <SolidColorBrush x:Key="NavActiveAccentBrush" Color="Transparent" />

    <RadialGradientBrush x:Key="WindowBackgroundBrush"
                         GradientOrigin="0.5,0.18"
                         Center="0.5,0.18"
                         RadiusX="1.1"
                         RadiusY="0.95">
        <GradientStop Color="{DynamicResource Bg1}" Offset="0" />
        <GradientStop Color="{DynamicResource Bg0}" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#55000000" />
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#77000000" />

    <SolidColorBrush x:Key="HomePageCardBackgroundBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="HomePageCardBorderBrush" Color="{DynamicResource CardStroke}" />

    <!-- Copy same styles as Dark.xaml (TitleBarButton, CloseTitleBarButton, NavButtonStyle, FabStyle, ScrollBar)
         They reference DynamicResource keys, so no duplication of colors needed beyond the brush keys above. -->

    <Style TargetType="{x:Type ScrollBar}" BasedOn="{x:Null}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb MinHeight="30">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="Bd"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource ScrollBarThumbBrush}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollBarThumbDraggingBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource TitleBarButtonBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBarButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#33000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseTitleBarButton"
           TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="#18E81123" />
        <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
        <Setter Property="BorderBrush" Value="#33E81123" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E81123" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Accent"
                                    Grid.Column="0"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="Transparent" />

                            <TextBlock x:Name="Icon"
                                       Grid.Column="0"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource HintBrush}"
                                       Text="{TemplateBinding Tag}" />

                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlaySoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#22000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlaySoftBrush}" />
                        </Trigger>

                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBgBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavActiveBorderBrush}" />
                            <Setter TargetName="Accent" Property="Background" Value="{DynamicResource NavActiveAccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Icon" Property="Foreground" Value="White" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FabStyle" TargetType="Button">
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="58" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="29">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource Blue0}" Offset="0" />
                                    <GradientStop Color="{DynamicResource Blue1}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.30" Color="#FF1A4ED8" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>