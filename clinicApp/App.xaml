<Application x:Class="clinicApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:clinicApp"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />

                <ui:ControlsDictionary />
                
                <!-- Default language (English) - will be replaced at runtime -->
                <ResourceDictionary Source="Resources/Languages/English/MainWindow.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/HomePage.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/PatientsPage.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/AppointmentsPage.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/Settings.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/Introduction.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/PrescriptionPage.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/IntroductionWindow.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/PatientHistoryWindow.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/QuickActionWindow.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/PatientCard.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/AddPatientPage.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/AddApointmentPage.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/AddSessionPage.xaml" />
                <ResourceDictionary Source="Resources/Languages/English/PasswordEntry.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
