<Page x:Class="clinicApp.AddPatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AddPatientPage"
      Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Names -->
            <RowDefinition Height="Auto"/>
            <!-- Phone -->
            <RowDefinition Height="Auto"/>
            <!-- Email -->
            <RowDefinition Height="*"/>
            <!-- Note -->
            <RowDefinition Height="Auto"/>
            <!-- Save -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Text="Ajoutes un nouveaux patient"
                   Grid.Row="0" Grid.ColumnSpan="2"
                   Foreground="White"
                   FontFamily="Constantia"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- First Name Label + TextBox -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="Nom"
                       Foreground="White"
                       FontFamily="Constantia"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="PatientFirstName"
                     FontFamily="Constantia"
                     Height="30"
                     BorderBrush="#0077FF"
                     BorderThickness="2"
                     ToolTip="Enter patient's first name"/>
        </StackPanel>

        <!-- Last Name Label + TextBox -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
            <TextBlock Text="Prenom"
                       Foreground="White"
                       FontFamily="Constantia"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="PatientLastName"
                     FontFamily="Constantia"
                     Height="30"
                     BorderBrush="#0077FF"
                     BorderThickness="2"
                     ToolTip="Enter patient's last name"/>
        </StackPanel>

        <!-- Phone Label + TextBox -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="Numero Telephone"
                       Foreground="White"
                       FontFamily="Constantia"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="Phone"
                     FontFamily="Constantia"
                     Height="30"
                     BorderBrush="#0077FF"
                     BorderThickness="2"
                     ToolTip="Enter patient's phone number"/>
        </StackPanel>

        <!-- Email Label + TextBox -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="Email"
                       Foreground="White"
                       FontFamily="Constantia"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="Email"
                     FontFamily="Constantia"
                     Height="30"
                     BorderBrush="#0077FF"
                     BorderThickness="2"
                     ToolTip="Enter patient's email"/>
        </StackPanel>

        <!-- Note Label + TextBox -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="Note"
                       Foreground="White"
                       FontFamily="Constantia"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="Note"
                     FontFamily="Constantia"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="#0077FF"
                     BorderThickness="2"
                     Height="100"
                     ToolTip="Optional notes about the patient"/>
        </StackPanel>

        <!-- Save Button -->
        <Button Grid.Row="5" Grid.ColumnSpan="2"
                Content="💾 Save"
                Background="#0077FF"
                Foreground="White"
                FontFamily="Constantia"
                FontWeight="Bold"
                Height="40"
                Click="SavePatient_Click"/>
    </Grid>
</Page>
