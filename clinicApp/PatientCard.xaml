<UserControl x:Class="clinicApp.PatientCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1E1E1E"
             Margin="10"
             Padding="15" Height="253">
    <Border BorderBrush="#0077FF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10"
            Background="#252526">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Full name (combined nicely) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Name: "
                           FontFamily="Constantia" 
                           Foreground="#AAAAAA"
                           FontWeight="SemiBold"
                           Width="80"/>
                <TextBox Text="{Binding FirstName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="True"
                         FontFamily="Constantia" 
                         BorderThickness="1"
                         BorderBrush="#0077FF"
                         Margin="0,0,5,0"
                         Background="#2D2D30"
                         Foreground="White"
                         Width="120"/>
                <TextBox Text="{Binding LastName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="True"
                         FontFamily="Constantia" 
                         BorderThickness="1"
                         BorderBrush="#0077FF"
                         Background="#2D2D30"
                         Foreground="White"
                         Width="120"/>
            </StackPanel>

            <!-- Phone -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Phone: "
                           FontFamily="Constantia" 
                           Foreground="#AAAAAA"
                           FontWeight="SemiBold"
                           Width="80"/>
                <TextBox Text="{Binding Phone, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="True"
                         FontFamily="Constantia" 
                         BorderThickness="1"
                         BorderBrush="#0077FF"
                         Background="#2D2D30"
                         Foreground="White"
                         Width="250"/>
            </StackPanel>

            <!-- Email -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Email: "
                           FontFamily="Constantia" 
                           Foreground="#AAAAAA"
                           FontWeight="SemiBold"
                           Width="80"/>
                <TextBox Text="{Binding Email, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="True"
                         FontFamily="Constantia" 
                         BorderThickness="1"
                         BorderBrush="#0077FF"
                         Background="#2D2D30"
                         Foreground="White"
                         Width="250"/>
            </StackPanel>

            <Button Content="History" 
                    FontFamily="Constantia" 
                    Width="80" Height="25" 
                    Margin="240,12,10,-37"
                    Click="HistoryButton_Click" Grid.Row="4"/>

            <!-- Note -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,0">
                <TextBlock Text="Note:"
                           FontFamily="Constantia" 
                           Foreground="#AAAAAA"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding Note, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="True"
                         FontFamily="Constantia" 
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="1"
                         BorderBrush="#0077FF"
                         Background="#2D2D30"
                         Foreground="White"
                         Height="60"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
